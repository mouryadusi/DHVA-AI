# The agent worker runs as its own long-lived process (see agent/README.md
# for why this can't live on Vercel). It needs its own env file separate
# from the Next.js app's .env.local, even though several values overlap.

# --- LiveKit (same project as the Next.js app) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase (service_role key — NEVER expose this to a browser/frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- STT ---
DEEPGRAM_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- TTS ---
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
